generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String     @id @default(uuid())
  email            String     @unique
  password         String
  name             String
  roleId           String
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  managedArtists   Artist[]   @relation("LabelArtists")
  artistProfile    Artist?
  createdGenres    Genre[]
  playlists        Playlist[]
  role             Role       @relation(fields: [roleId], references: [id])
  favorites        Song[]     @relation("UserFavorites")
  followingArtists Artist[]   @relation("UserFollowsArtist")
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  users       User[]
  permissions Permission[] @relation("PermissionToRole")
}

model Permission {
  id       String @id @default(uuid())
  action   String
  resource String
  roles    Role[] @relation("PermissionToRole")
}

model Artist {
  id        String        @id @default(uuid())
  name      String
  bio       String?
  imageUrl  String?
  bannerUrl String?
  gallery   String?
  certified Boolean       @default(false)
  birthDate DateTime?
  country   String?
  gender    String?
  userId    String?       @unique
  labelId   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  albums    Album[]
  label     User?         @relation("LabelArtists", fields: [labelId], references: [id])
  user      User?         @relation(fields: [userId], references: [id])
  groups    ArtistGroup[] @relation("ArtistGroupMembers")
  songs     Song[]        @relation("SongArtists")
  followers User[]        @relation("UserFollowsArtist")
}

model ArtistGroup {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   Artist[] @relation("ArtistGroupMembers")
  songs     Song[]   @relation("SongGroups")
}

model Album {
  id          String   @id @default(uuid())
  title       String
  year        Int
  coverUrl    String?
  description String?
  artistId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  artist      Artist   @relation(fields: [artistId], references: [id])
  songs       Song[]
}

model Song {
  id          String        @id @default(uuid())
  title       String
  duration    Int
  coverUrl    String?
  isSingle    Boolean       @default(false)
  audioUrl    String
  albumId     String?
  genreId     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  album       Album?        @relation(fields: [albumId], references: [id])
  genre       Genre         @relation(fields: [genreId], references: [id])
  playlists   Playlist[]    @relation("PlaylistSongs")
  artists     Artist[]      @relation("SongArtists")
  groups      ArtistGroup[] @relation("SongGroups")
  favoritedBy User[]        @relation("UserFavorites")
}

model Genre {
  id          String   @id @default(uuid())
  name        String   @unique
  createdById String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation(fields: [createdById], references: [id])
  songs       Song[]
}

model Playlist {
  id        String   @id @default(uuid())
  name      String
  coverUrl  String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  songs     Song[]   @relation("PlaylistSongs")
}

model MaintenanceSubscription {
  id         String   @id @default(uuid())
  email      String   @unique
  notifiedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model MaintenanceState {
  id        String   @id @default("default")
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
