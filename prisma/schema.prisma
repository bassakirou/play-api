generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  password         String
  name             String
  roleId           String
  systemRoles      String[]        @default([])
  resetToken       String?
  resetTokenExpiry DateTime?
  isEmailVerified  Boolean         @default(false)
  verificationCode String?
  verificationCodeExpiry DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  managedArtists   Artist[]        @relation("LabelArtists")
  artistProfile    Artist?
  createdGenres    Genre[]
  playlists        Playlist[]
  role             Role            @relation(fields: [roleId], references: [id])
  VideoPlaylist    VideoPlaylist[]
  favorites        Song[]          @relation("UserFavorites")
  followingArtists Artist[]        @relation("UserFollowsArtist")
  videos           Video[]
  audiobooks       Audiobook[]     @relation("UserAudiobooks")
  mediaAssets      MediaAsset[]
  lives            LiveStream[]    @relation("UserLives")
  liveComments     LiveComment[]
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  users       User[]
  permissions Permission[] @relation("PermissionToRole")
}

model Permission {
  id       String @id @default(uuid())
  action   String
  resource String
  roles    Role[] @relation("PermissionToRole")

  @@unique([action, resource])
}

model Artist {
  id        String        @id @default(uuid())
  name      String
  bio       String?
  imageUrl  String?
  bannerUrl String?
  gallery   String?
  certified Boolean       @default(false)
  birthDate DateTime?
  country   String?
  gender    String?
  userId    String?       @unique
  labelId   String?
  views     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  albums    Album[]
  label     User?         @relation("LabelArtists", fields: [labelId], references: [id])
  user      User?         @relation(fields: [userId], references: [id])
  groups           ArtistGroup[]           @relation("ArtistGroupMembers")
  groupInvitations ArtistGroupInvitation[]
  songs            Song[]                  @relation("SongArtists")
  followers        User[]                  @relation("UserFollowsArtist")
  videos           Video[]                 @relation("VideoArtists")
}

model ArtistGroup {
  id            String                  @id @default(uuid())
  name          String
  imageUrl      String?
  creatorId     String?
  customMembers String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  members       Artist[]                @relation("ArtistGroupMembers")
  invitations   ArtistGroupInvitation[]
  songs         Song[]                  @relation("SongGroups")
  albums        Album[]                 @relation("AlbumGroups")
}

model ArtistGroupInvitation {
  id        String      @id @default(uuid())
  groupId   String
  artistId  String
  status    String      @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  group     ArtistGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  artist    Artist      @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([groupId, artistId])
}

model Album {
  id          String        @id @default(uuid())
  title       String
  year        Int
  coverUrl    String?
  description String?
  artistId    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  artist      Artist?       @relation(fields: [artistId], references: [id])
  groups      ArtistGroup[] @relation("AlbumGroups")
  songs       Song[]
}

model Song {
  id          String        @id @default(uuid())
  title       String
  duration    Int
  coverUrl    String?
  isSingle    Boolean       @default(false)
  audioUrl    String
  albumId     String?
  genreId     String?
  plays       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  album       Album?        @relation(fields: [albumId], references: [id])
  genre       Genre?        @relation(fields: [genreId], references: [id])
  genres      Genre[]       @relation("SongGenres")
  playlists   Playlist[]    @relation("PlaylistSongs")
  artists     Artist[]      @relation("SongArtists")
  groups      ArtistGroup[] @relation("SongGroups")
  favoritedBy User[]        @relation("UserFavorites")
}

model Genre {
  id          String   @id @default(uuid())
  name        String   @unique
  createdById String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation(fields: [createdById], references: [id])
  songs       Song[]
  songList    Song[]   @relation("SongGenres")
  videos      Video[]
}

model Playlist {
  id        String   @id @default(uuid())
  name      String
  coverUrl  String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  songs     Song[]   @relation("PlaylistSongs")
}

model MaintenanceSubscription {
  id         String   @id @default(uuid())
  email      String   @unique
  notifiedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model MaintenanceState {
  id             String   @id @default("default")
  enabled        Boolean  @default(false)
  adminPriority  Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

model Video {
  id            String          @id @default(uuid())
  title         String
  description   String?
  videoUrl      String
  thumbnailUrl  String?
  duration      Int
  views         Int             @default(0)
  likes         Int             @default(0)
  isPublished   Boolean         @default(false)
  category      String?
  tags          String[]        @default([])
  genreId       String?
  userId        String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  genre         Genre?          @relation(fields: [genreId], references: [id])
  artists       Artist[]        @relation("VideoArtists")
  VideoPlaylist VideoPlaylist[] @relation("VideoPlaylistVideos")
}

model VideoPlaylist {
  id          String   @id
  name        String
  description String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  User        User     @relation(fields: [userId], references: [id])
  Video       Video[]  @relation("VideoPlaylistVideos")
}

model Audiobook {
  id           String             @id @default(uuid())
  title        String
  author       String
  authorId     String?
  narrator     String?
  description  String?
  coverUrl     String?
  duration     Int                @default(0) // Durée totale en secondes (somme des chapitres)
  category     String             @default("Général")
  rating       Float              @default(5.0)
  totalReviews Int                @default(0)
  isTrending   Boolean            @default(false)
  isNew        Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  authorUser   User?              @relation("UserAudiobooks", fields: [authorId], references: [id], onDelete: SetNull)
  chapters     AudiobookChapter[]
}

model AudiobookChapter {
  id          String    @id @default(uuid())
  audiobookId String
  title       String
  duration    Int       @default(0) // Durée en secondes
  startAt     Int       @default(0) // Point de départ en secondes
  audioUrl    String?   // URL MinIO du fichier audio
  order       Int       @default(0)
  text        String?   @db.Text
  audioSource String?   @default("HUMAN") // "HUMAN" | "TTS"
  status      String?   @default("READY") // "READY" | "PENDING" | "PROCESSING" | "FAILED"
  timestamps  Json?     // Données d'alignement texte-audio / timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  audiobook   Audiobook @relation(fields: [audiobookId], references: [id], onDelete: Cascade)
}

model MediaAsset {
  id           String   @id @default(uuid())
  title        String
  filename     String
  fileUrl      String
  thumbnailUrl String?
  type         String   // "audio" | "video" | "image"
  mimeType     String?
  size         Int?     // bytes
  duration     Int?     // seconds for audio/video
  format       String?  // e.g. "MP3", "WAV", "MP4", "JPG", "PNG", "WEBP"
  userId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model LiveStream {
  id            String         @id @default(uuid())
  title         String
  description   String?
  type          String         @default("video") // "video" | "radio"
  category      String         @default("all")   // "concerts" | "talk" | "radio" | "video" | "music"
  status        String         @default("LIVE")  // "SCHEDULED" | "LIVE" | "ENDED"
  streamKey     String         @unique @default(uuid())
  streamUrl     String?
  playbackType  String         @default("WEBRTC") // "WEBRTC" | "HLS" | "AUDIO_STREAM" | "EXTERNAL"
  thumbnailUrl  String?
  coverUrl      String?
  tags          String[]       @default([])
  viewerCount   Int            @default(0)
  peakViewers   Int            @default(0)
  likesCount    Int            @default(0)
  isFeatured    Boolean        @default(false)
  scheduledAt   DateTime?
  startedAt     DateTime?      @default(now())
  endedAt       DateTime?
  retentionDays Int            @default(3) // 0 = delete immediately, 1-7 days retention
  recordingUrl  String?
  isRecorded    Boolean        @default(false)
  cleanupAt     DateTime?
  isCleanedUp   Boolean        @default(false)
  userId        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User?          @relation("UserLives", fields: [userId], references: [id], onDelete: SetNull)
  comments      LiveComment[]
  reactions     LiveReaction[]
}

model LiveComment {
  id         String     @id @default(uuid())
  liveId     String
  userId     String?
  userName   String
  userAvatar String?
  role       String?    // "HOST" | "ADMIN" | "VIP" | "USER"
  text       String
  createdAt  DateTime   @default(now())
  live       LiveStream @relation(fields: [liveId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model LiveReaction {
  id        String     @id @default(uuid())
  liveId    String
  emoji     String     // e.g. "❤️", "🔥", "👏", "🤩", "🎉", "💯"
  count     Int        @default(1)
  createdAt DateTime   @default(now())
  live      LiveStream @relation(fields: [liveId], references: [id], onDelete: Cascade)
}

