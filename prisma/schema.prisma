generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  password         String
  name             String
  roleId           String
  systemRoles      String[]        @default([])
  resetToken       String?
  resetTokenExpiry DateTime?
  isEmailVerified  Boolean         @default(false)
  verificationCode String?
  verificationCodeExpiry DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  managedArtists   Artist[]        @relation("LabelArtists")
  artistProfile    Artist?
  createdGenres    Genre[]
  playlists        Playlist[]
  role             Role            @relation(fields: [roleId], references: [id])
  VideoPlaylist    VideoPlaylist[]
  favorites        Song[]          @relation("UserFavorites")
  followingArtists Artist[]        @relation("UserFollowsArtist")
  videos           Video[]
  audiobooks       Audiobook[]     @relation("UserAudiobooks")
  mediaAssets      MediaAsset[]
  lives            LiveStream[]    @relation("UserLives")
  liveComments     LiveComment[]
  videoComments    VideoComment[]
  instructedCourses AcademicCourse[] @relation("InstructorCourses")
  enrollments       CourseEnrollment[]
  transactions      Transaction[]          @relation("UserTransactions")
  purchasedContents UserPurchasedContent[] @relation("UserPurchases")
  sentGifts         GiftTransaction[]      @relation("SentGifts")
  subscriptions     UserSubscription[]     @relation("UserSubscriptions")
  withdrawals       WithdrawalRequest[]    @relation("UserWithdrawals")
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  users       User[]
  permissions Permission[] @relation("PermissionToRole")
}

model Permission {
  id       String @id @default(uuid())
  action   String
  resource String
  roles    Role[] @relation("PermissionToRole")

  @@unique([action, resource])
}

model Artist {
  id        String        @id @default(uuid())
  name      String
  bio       String?
  imageUrl  String?
  bannerUrl String?
  gallery   String?
  certified Boolean       @default(false)
  birthDate DateTime?
  country   String?
  gender    String?
  userId    String?       @unique
  labelId   String?
  views     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  albums    Album[]
  label     User?         @relation("LabelArtists", fields: [labelId], references: [id])
  user      User?         @relation(fields: [userId], references: [id])
  groups           ArtistGroup[]           @relation("ArtistGroupMembers")
  groupInvitations ArtistGroupInvitation[]
  songs            Song[]                  @relation("SongArtists")
  followers        User[]                  @relation("UserFollowsArtist")
  videos           Video[]                 @relation("VideoArtists")
  receivedGifts    GiftTransaction[]       @relation("ArtistReceivedGifts")
  withdrawals      WithdrawalRequest[]     @relation("ArtistWithdrawals")
}

model ArtistGroup {
  id            String                  @id @default(uuid())
  name          String
  imageUrl      String?
  creatorId     String?
  customMembers String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  members       Artist[]                @relation("ArtistGroupMembers")
  invitations   ArtistGroupInvitation[]
  songs         Song[]                  @relation("SongGroups")
  albums        Album[]                 @relation("AlbumGroups")
}

model ArtistGroupInvitation {
  id        String      @id @default(uuid())
  groupId   String
  artistId  String
  status    String      @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  group     ArtistGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  artist    Artist      @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([groupId, artistId])
}

model Album {
  id          String        @id @default(uuid())
  title       String
  year        Int
  coverUrl    String?
  description String?
  isAcademic  Boolean       @default(false)
  isMonetized Boolean       @default(false)
  price       Int           @default(0) // en XAF
  discountPrice Int?        // en XAF (optionnel)
  artistId    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  artist      Artist?       @relation(fields: [artistId], references: [id])
  groups      ArtistGroup[] @relation("AlbumGroups")
  songs       Song[]
}

model Song {
  id          String        @id @default(uuid())
  title       String
  duration    Int
  coverUrl    String?
  isSingle    Boolean       @default(false)
  isAcademic  Boolean       @default(false)
  isMonetized Boolean       @default(false)
  price       Int           @default(0) // en XAF
  discountPrice Int?        // en XAF (optionnel)
  audioUrl    String
  albumId     String?
  genreId     String?
  plays       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  album       Album?        @relation(fields: [albumId], references: [id])
  genre       Genre?        @relation(fields: [genreId], references: [id])
  genres      Genre[]       @relation("SongGenres")
  playlists   Playlist[]    @relation("PlaylistSongs")
  artists     Artist[]      @relation("SongArtists")
  groups      ArtistGroup[] @relation("SongGroups")
  favoritedBy User[]        @relation("UserFavorites")
}

model Genre {
  id          String   @id @default(uuid())
  name        String   @unique
  createdById String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation(fields: [createdById], references: [id])
  songs       Song[]
  songList    Song[]   @relation("SongGenres")
  videos      Video[]
}

model Playlist {
  id        String   @id @default(uuid())
  name      String
  coverUrl  String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  songs     Song[]   @relation("PlaylistSongs")
}

model MaintenanceSubscription {
  id         String   @id @default(uuid())
  email      String   @unique
  notifiedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model MaintenanceState {
  id             String   @id @default("default")
  enabled        Boolean  @default(false)
  adminPriority  Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

model Video {
  id            String          @id @default(uuid())
  title         String
  description   String?
  videoUrl      String
  thumbnailUrl  String?
  duration      Int
  views         Int             @default(0)
  likes         Int             @default(0)
  isPublished   Boolean         @default(false)
  isAcademic    Boolean         @default(false)
  isMonetized   Boolean         @default(false)
  price         Int             @default(0) // en XAF
  discountPrice Int?            // en XAF (optionnel)
  category      String?
  tags          String[]        @default([])
  categoryId    String?
  genreId       String?
  userId        String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  genre         Genre?          @relation(fields: [genreId], references: [id])
  videoCategory VideoCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  videoTags     VideoTagOnVideo[]
  taxonomyEvents VideoTaxonomyEvent[]
  artists       Artist[]        @relation("VideoArtists")
  VideoPlaylist VideoPlaylist[] @relation("VideoPlaylistVideos")
  comments      VideoComment[]
}

model VideoComment {
  id            String         @id @default(uuid())
  videoId       String
  userId        String?
  userName      String
  userAvatar    String?
  content       String         @db.Text
  likes         Int            @default(0)
  isCreator     Boolean        @default(false)
  channelName   String?
  channelAvatar String?
  parentId      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  video         Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent        VideoComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       VideoComment[] @relation("CommentReplies")

  @@index([videoId, createdAt])
  @@index([parentId])
  @@index([userId])
}

model VideoCategory {
  id             String               @id @default(uuid())
  name           String
  normalizedName String               @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  videos         Video[]
  tags           VideoTag[]
  events         VideoTaxonomyEvent[]

  @@unique([name])
  @@index([normalizedName])
}

model VideoTag {
  id             String               @id @default(uuid())
  name           String
  normalizedName String               @unique
  categoryId     String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  category       VideoCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  videos         VideoTagOnVideo[]
  events         VideoTaxonomyEvent[]

  @@index([categoryId])
}

model VideoTagOnVideo {
  videoId String
  tagId   String
  video   Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  tag     VideoTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([videoId, tagId])
  @@index([tagId])
}

model VideoTaxonomyEvent {
  id         String         @id @default(uuid())
  type       String
  country    String?
  videoId    String?
  categoryId String?
  tagId      String?
  createdAt  DateTime       @default(now())
  video      Video?         @relation(fields: [videoId], references: [id], onDelete: SetNull)
  category   VideoCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tag        VideoTag?      @relation(fields: [tagId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([country, createdAt])
  @@index([categoryId, createdAt])
  @@index([tagId, createdAt])
}

model VideoPlaylist {
  id          String   @id
  name        String
  description String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  User        User     @relation(fields: [userId], references: [id])
  Video       Video[]  @relation("VideoPlaylistVideos")
}

model Audiobook {
  id           String             @id @default(uuid())
  title        String
  author       String
  authorId     String?
  narrator     String?
  description  String?
  coverUrl     String?
  duration     Int                @default(0) // Durée totale en secondes (somme des chapitres)
  category     String             @default("Général")
  rating       Float              @default(5.0)
  totalReviews Int                @default(0)
  isTrending   Boolean            @default(false)
  isNew        Boolean            @default(true)
  isMonetized  Boolean            @default(false)
  price        Int                @default(0) // en XAF
  discountPrice Int?              // en XAF (optionnel)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  authorUser   User?              @relation("UserAudiobooks", fields: [authorId], references: [id], onDelete: SetNull)
  chapters     AudiobookChapter[]
}

model AudiobookChapter {
  id          String    @id @default(uuid())
  audiobookId String
  title       String
  duration    Int       @default(0) // Durée en secondes
  startAt     Int       @default(0) // Point de départ en secondes
  audioUrl    String?   // URL MinIO du fichier audio
  order       Int       @default(0)
  text        String?   @db.Text
  audioSource String?   @default("HUMAN") // "HUMAN" | "TTS"
  status      String?   @default("READY") // "READY" | "PENDING" | "PROCESSING" | "FAILED"
  timestamps  Json?     // Données d'alignement texte-audio / timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  audiobook   Audiobook @relation(fields: [audiobookId], references: [id], onDelete: Cascade)
}

model MediaAsset {
  id           String   @id @default(uuid())
  title        String
  filename     String
  fileUrl      String
  thumbnailUrl String?
  type         String   // "audio" | "video" | "image"
  mimeType     String?
  size         Int?     // bytes
  duration     Int?     // seconds for audio/video
  format       String?  // e.g. "MP3", "WAV", "MP4", "JPG", "PNG", "WEBP"
  userId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model LiveStream {
  id            String         @id @default(uuid())
  title         String
  description   String?
  type          String         @default("video") // "video" | "radio"
  category      String         @default("all")   // "concerts" | "talk" | "radio" | "video" | "music"
  status        String         @default("LIVE")  // "SCHEDULED" | "LIVE" | "ENDED"
  isAcademic    Boolean        @default(false)
  streamKey     String         @unique @default(uuid())
  streamUrl     String?
  playbackType      String         @default("WEBRTC") // "WEBRTC" | "HLS" | "AUDIO_STREAM" | "EXTERNAL"
  aspectRatio       String?        @default("auto")   // "16:9" | "9:16" | "auto"
  isPrivate         Boolean        @default(false)
  privateAccessType String?        @default("link")   // "link" | "invite"
  accessKey         String?        @default(uuid())
  invitedEmails     String[]       @default([])
  thumbnailUrl      String?
  coverUrl      String?
  tags          String[]       @default([])
  viewerCount   Int            @default(0)
  peakViewers   Int            @default(0)
  likesCount    Int            @default(0)
  isFeatured    Boolean        @default(false)
  scheduledAt   DateTime?
  startedAt     DateTime?      @default(now())
  endedAt       DateTime?
  retentionDays Int            @default(3) // 0 = delete immediately, 1-7 days retention
  recordingUrl  String?
  isRecorded    Boolean        @default(false)
  cleanupAt     DateTime?
  isCleanedUp   Boolean        @default(false)
  userId        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User?          @relation("UserLives", fields: [userId], references: [id], onDelete: SetNull)
  comments      LiveComment[]
  reactions     LiveReaction[]
}

model LiveComment {
  id         String     @id @default(uuid())
  liveId     String
  userId     String?
  userName   String
  userAvatar String?
  role       String?    // "HOST" | "ADMIN" | "VIP" | "USER"
  text       String
  createdAt  DateTime   @default(now())
  live       LiveStream @relation(fields: [liveId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model LiveReaction {
  id        String     @id @default(uuid())
  liveId    String
  emoji     String     // e.g. "❤️", "🔥", "👏", "🤩", "🎉", "💯"
  count     Int        @default(1)
  createdAt DateTime   @default(now())
  live      LiveStream @relation(fields: [liveId], references: [id], onDelete: Cascade)
}

model AcademicCourse {
  id               String             @id @default(uuid())
  title            String
  subtitle         String?
  description      String?            @db.Text
  thumbnailUrl     String?
  previewVideoUrl  String?
  category         String             @default("Général") // "Tech & Code", "Business & Finance", "Langues & Cultures", etc.
  level            String             @default("ALL_LEVELS") // "BEGINNER" | "INTERMEDIATE" | "ADVANCED" | "ALL_LEVELS"
  language         String             @default("Français")
  durationHours    Float              @default(0)
  rating           Float              @default(5.0)
  totalReviews     Int                @default(0)
  studentsCount    Int                @default(0)
  isPublished      Boolean            @default(true)
  isFeatured       Boolean            @default(false)
  isBestseller     Boolean            @default(false)
  learningOutcomes String[]           @default([])
  requirements     String[]           @default([])
  instructorId     String?
  instructorBio    String?            @db.Text
  instructorTitle  String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  instructor       User?              @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: SetNull)
  modules          AcademicModule[]
  enrollments      CourseEnrollment[]
}

model AcademicModule {
  id        String           @id @default(uuid())
  courseId  String
  title     String
  order     Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  course    AcademicCourse   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   AcademicLesson[]
}

model AcademicLesson {
  id              String         @id @default(uuid())
  moduleId        String
  title           String
  description     String?        @db.Text
  contentType     String         @default("VIDEO") // "VIDEO" | "AUDIO" | "ARTICLE"
  contentUrl      String?
  durationSeconds Int            @default(0)
  order           Int            @default(0)
  isFreePreview   Boolean        @default(false)
  resources       Json?
  notes           String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  module          AcademicModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model CourseEnrollment {
  id               String         @id @default(uuid())
  userId           String
  courseId         String
  progressPercent  Int            @default(0)
  completedLessons String[]       @default([])
  currentLessonId  String?
  isCompleted      Boolean        @default(false)
  enrolledAt       DateTime       @default(now())
  completedAt      DateTime?
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course           AcademicCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model SharePlatform {
  id                 String   @id @default(uuid())
  key                String   @unique
  name               String
  icon               String
  shareUrl           String
  enabled            Boolean  @default(true)
  order              Int      @default(0)
  color              String?
  includeTitle       Boolean  @default(true)
  includeAuthor      Boolean  @default(true)
  includeDescription Boolean  @default(false)
  defaultHashtags    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ShareModalConfig {
  id                String   @id @default("default")
  showMediaPreview  Boolean  @default(false)
  showCustomization Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

model LiveSettingsConfig {
  id                   String   @id @default("default")
  maxDurationMinutes   Int      @default(60) // Durée max d'un live (minutes)
  maxViewers           Int      @default(500) // Nombre max de spectateurs simultanés (0 = illimité)
  enableRetention0Days Boolean  @default(true) // 0 jours (immédiat)
  enableRetention3Days Boolean  @default(true) // 3 jours de replay
  enableRetention7Days Boolean  @default(true) // 7 jours de replay
  updatedAt            DateTime @updatedAt
}

// ==========================================
// MODULE MONÉTISATION & PAIEMENTS TARA MONEY
// ==========================================

model MonetizationConfig {
  id                 String   @id @default("default")
  // Clés et credentials Tara Money (stockés de façon sécurisée)
  taraApiKey         String?  // Clé fournie par Tara
  taraBusinessId     String?  // Business ID Tara
  taraWebhookSecret  String?  // Secret Webhook (facultatif / configuré)
  taraBaseUrl        String?  @default("https://www.dklo.co/api/tara") // Base URL de l'API Tara
  taraReturnUrl      String?  // URL de redirection après paiement (ex: https://play.pyramidplay.cm)
  taraWebhookUrl     String?  // URL du Webhook de notification (ex: Ngrok en local ou URL prod)
  isLiveMode         Boolean  @default(false) // Sandbox vs Production

  // Commissions de la plateforme
  platformFeePercent Float    @default(30.0) // 30% PyramidPlay
  creatorSharePercent Float   @default(70.0) // 70% Créateurs / Auteurs

  // Frais et seuils de retrait
  minWithdrawalAmount Int     @default(5000) // Seuil min de réclamation en XAF
  operatorOmFeePercent Float  @default(1.5)  // Frais de transfert OM déduits au créateur (%)
  operatorMomoFeePercent Float @default(1.5) // Frais de transfert MoMo déduits au créateur (%)
  
  updatedAt          DateTime @updatedAt
}

model GiftCatalog {
  id          String            @id @default(uuid())
  name        String            @unique // ex: "LION", "TORTUE", "CAURIS", "ELEPHANT", "PANTHERE"
  label       String            // ex: "Le Lion Royal", "La Tortue Sage", "Le Cauris Sacré"
  amount      Int               // Montant en XAF (ex: 100000, 5000, 500)
  iconUrl     String            // URL MinIO / Cloud de l'icône (PNG, SVG, GIF)
  description String?           // Description symbolique inspirée de la cosmogonie africaine
  order       Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  giftsSent   GiftTransaction[]
}

model SubscriptionPlan {
  id            String             @id @default(uuid())
  name          String             // ex: "Plan Formateur & Créateur Académique"
  code          String             @unique // ex: "ACADEMIC_MONTHLY"
  targetRole    String             @default("ACADEMIC") // Rôle visé
  price         Int                @default(5000) // 5000 XAF par mois
  durationDays  Int                @default(30)
  description   String?
  features      String[]           @default([])
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  subscriptions UserSubscription[]
}

model UserSubscription {
  id         String           @id @default(uuid())
  userId     String
  planId     String
  status     String           @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  startDate  DateTime         @default(now())
  endDate    DateTime
  paymentId  String?          // Référence Tara
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  plan       SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Transaction {
  id                  String            @id @default(uuid())
  paymentId           String?           @unique // Identifiant unique renvoyé par Tara Money
  productId           String            // Référence unique générée pour l'appel Tara
  userId              String?           // Utilisateur qui a payé
  type                String            // "CONTENT_PURCHASE" | "GIFT" | "ACADEMIC_SUBSCRIPTION"
  amount              Int               // Montant total payé en XAF
  currency            String            @default("XAF")
  platformFee         Int               @default(0) // Part 30% PyramidPlay
  creatorShare        Int               @default(0) // Part 70% Créateur / Artiste
  taraFee             Int               @default(0) // Frais Tara
  status              String            @default("PENDING") // PENDING, SUCCESS, FAILURE
  vendor              String?           // "ORANGE_CMR" | "MTN_MOMO_CMR"
  phoneNumber         String?           // Format 2376xxxxxxxx
  beneficiaryArtistId String?           // Artiste / Créateur bénéficiaire du produit ou cadeau
  contentId           String?           // ID du Single, Album, Video ou Audiobook
  contentType         String?           // "SONG" | "ALBUM" | "VIDEO" | "AUDIOBOOK"
  metadata            Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user                User?             @relation("UserTransactions", fields: [userId], references: [id], onDelete: SetNull)
  giftTransaction     GiftTransaction?

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([beneficiaryArtistId])
  @@index([productId])
}

model UserPurchasedContent {
  id          String   @id @default(uuid())
  userId      String
  contentId   String   // ID du Single, Album, Video ou Audiobook
  contentType String   // "SONG" | "ALBUM" | "VIDEO" | "AUDIOBOOK"
  title       String?  // Snapshot du titre au moment de l'achat
  pricePaid   Int      // Montant payé en XAF
  paymentId   String?  // Tara paymentId
  createdAt   DateTime @default(now())

  user        User     @relation("UserPurchases", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId, contentType])
  @@index([userId])
  @@index([contentId])
}

model GiftTransaction {
  id            String       @id @default(uuid())
  transactionId String       @unique
  giftCatalogId String
  senderUserId  String?
  recipientArtistId String
  message       String?
  createdAt     DateTime     @default(now())

  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  gift          GiftCatalog  @relation(fields: [giftCatalogId], references: [id], onDelete: Cascade)
  sender        User?        @relation("SentGifts", fields: [senderUserId], references: [id], onDelete: SetNull)
  recipient     Artist       @relation("ArtistReceivedGifts", fields: [recipientArtistId], references: [id], onDelete: Cascade)

  @@index([recipientArtistId])
  @@index([senderUserId])
}

model WithdrawalRequest {
  id              String    @id @default(uuid())
  userId          String    // Utilisateur créateur demandeur
  artistId        String    // Artiste associé
  amountRequested Int       // Montant brut demandé (ses 70% cumulés)
  operatorFees    Int       // Frais de transfert OM/MoMo supportés par le bénéficiaire
  netAmount       Int       // Montant net effectivement versé au créateur
  paymentMethod   String    // "MTN_MOBILE_MONEY" | "ORANGE_MONEY"
  phoneNumber     String    // 2376xxxxxxxx
  status          String    @default("PENDING") // PENDING, APPROVED, PROCESSING, PAID, REJECTED
  rejectionReason String?
  payoutId        String?   // ID du Payout Tara Money
  processedById   String?   // Super Admin qui a traité
  requestedAt     DateTime  @default(now())
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation("UserWithdrawals", fields: [userId], references: [id], onDelete: Cascade)
  artist          Artist    @relation("ArtistWithdrawals", fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
  @@index([status])
  @@index([userId])
}


